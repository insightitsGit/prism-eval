include LICENSE README.md CHANGELOG.md SECURITY.md SUPPORT.md pyproject.toml
recursive-include prism_eval *.py
recursive-include tests *.py
recursive-include testdata *
recursive-include docs *.md *.html
recursive-include demo *.py *.md
graft scripts
global-exclude *.py[cod] __pycache__ .pytest_cache *.egg-info
